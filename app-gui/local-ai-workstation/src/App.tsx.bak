// ==========================================
// Types
// ==========================================
type View = "chat" | "models" | "server" | "discover";
type MessageRole = "user" | "assistant";
type DownloadState = "idle" | "downloading" | "done" | "failed";
type ModelLoadingState = "not_loaded" | "loading" | "loaded" | "unloading" | "failed";

export type SettingsMode = "simple" | "advanced";
export type ResponseStyle = "precise" | "balanced" | "creative" | "deterministic";
export type ResponseLength = "concise" | "standard" | "detailed";

interface ModelInfo {
  id: string;
  path: string;
  size: number;
}

interface Message {
  role: MessageRole;
  text: string;
  thought?: string;
  stats?: {
    tokPerSec?: number;
    tokens?: number;
    latencyMs?: number;
  };
}

interface Conversation {
  id: string;
  title: string;
  messages: Message[];
  updatedAt: number;
}

export interface GenerationSettings {
  temperature: number;
  topP: number;
  topK: number;
  minP: number;
  maxTokens: number;
  stopSequences: string[];
  repetitionPenalty: number;
  frequencyPenalty: number;
  presencePenalty: number;
  seed: number | null;
  systemPrompt: string;
}

export interface Preset {
  id: string;
  name: string;
  category: "Coding" | "General" | "Reasoning" | "Creative" | "JSON";
  description: string;
  style: ResponseStyle;
  length: ResponseLength;
  settings: GenerationSettings;
}

interface HfModelItem {
  id: string;
  downloads?: number;
  likes?: number;
  pipeline_tag?: string;
  tags?: string[];
}

interface RequestLog {
  id: string;
  time: string;
  method: "POST" | "GET";
  path: string;
  status: string;
  latency: string;
  rate: string;
  requestJson?: string;
  responseStream?: string;
}

